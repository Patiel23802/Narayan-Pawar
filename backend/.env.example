# Copy to `.env` in this folder (gitignored): `cp .env.example .env`

# HTTP
PORT=4000
# Listen on all interfaces so a phone on Wi‑Fi can reach the API (default).
HOST=0.0.0.0

NODE_ENV=development

# Postgres — leave empty to use local default:
#   postgres://$USER@localhost:5432/civic_pulse   (macOS + Homebrew + trust auth)
# Docker / Linux example:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/civic_pulse
DATABASE_URL=

# Auth — set a long random string in any shared or production environment
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Dev fallback OTP when SMS_PROVIDER is not set (local development only).
DEV_OTP=123456
EXPOSE_DEV_OTP=1

# --- Real SMS (required in production) ---
# Provider: msg91 | fast2sms | twilio
# SMS_PROVIDER=fast2sms
# FAST2SMS_API_KEY=your_api_key
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=your_authkey
# MSG91_TEMPLATE_ID=your_dlt_template_id
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Firebase Phone Auth — path to service account JSON from Firebase Console
# (Project settings → Service accounts → Generate new private key)
# Required for POST /api/auth/firebase-phone (mobile app after real SMS OTP).
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/politics-c7b50-firebase-adminsdk.json

# CORS: `*` for dev, or comma-separated origins, e.g. https://app.example.com
CORS_ORIGIN=*

# Dummy password login (mobile 9999999999 / dummy123) — off in production unless set to 1
ALLOW_DUMMY_LOGIN=

# Optional seed overrides (see backend/src/seeders/seed.js)
# SEED_ADMIN_MOBILE=
# SEED_ADMIN_PASSWORD=
# SEED_USER_MOBILE=
# SEED_USER_PASSWORD=
