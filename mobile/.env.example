# Expo loads variables prefixed with EXPO_PUBLIC_ into the JS bundle.
# Copy to `.env` in this folder: `cp .env.example .env`

# Full API base URL (no trailing slash). Use this when:
# - Your phone cannot resolve the dev machine (e.g. Expo Tunnel without LAN API)
# - You deploy the API and want a fixed URL
# Example (replace with your computer's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
#
# Deployed Docker stack (HTTPS optional): use public origin so paths like /api and /uploads work.
# Same URL you open in the browser host, no trailing slash, e.g.:
# EXPO_PUBLIC_API_URL=https://civicpulse.example.org
# Production (sslip hostname must match Caddyfile if IP changes), e.g.:
# EXPO_PUBLIC_API_URL=https://139-59-5-79.sslip.io

# Port only used when apiUrl in app.json is loopback and the app rewrites the host (default 4000).
# EXPO_PUBLIC_API_PORT=4000

# --- Firebase Phone Auth (real SMS) ---
# 1. Firebase Console → Authentication → Sign-in method → enable Phone.
# 2. Android app package: com.civicpulse.nagarsevak
# 3. REQUIRED — fix auth/missing-client-identifier:
#    bash scripts/print-android-sha.sh
#    Add SHA-1 + SHA-256 in Firebase → Project settings → Your Android app → Add fingerprint
#    Re-download google-services.json (oauth_client must NOT be empty) → mobile/google-services.json
#    npx expo prebuild --platform android --clean && npm run build:apk
# 4. Backend: service account JSON → FIREBASE_SERVICE_ACCOUNT_PATH in backend .env
# 5. Blaze billing for SMS; optional test phone numbers while developing.
EXPO_PUBLIC_FIREBASE_PHONE=1
