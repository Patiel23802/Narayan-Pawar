# Expo loads EXPO_PUBLIC_* into the JS bundle. Copy: cp .env.example .env
# app.config.js also bakes otpMode into extra — rebuild APK after any change.

EXPO_PUBLIC_API_URL=https://139-59-5-79.sslip.io

# --- Firebase-only OTP (recommended for this project) ---
EXPO_PUBLIC_OTP_MODE=firebase
EXPO_PUBLIC_FIREBASE_PHONE=1
EXPO_PUBLIC_FIREBASE_PROJECT_ID=politics-c7b50

# 1. Firebase Console → Authentication → Phone → Enable
# 2. bash scripts/print-android-sha.sh → add SHA-1 + SHA-256 → re-download google-services.json
# 3. npx expo prebuild --platform android --clean && npm run build:apk
# 4. Server: backend/secrets/firebase-service-account.json + OTP_AUTH_MODE=firebase

# Temporary while testing (Firebase Console test phone numbers):
# EXPO_PUBLIC_FIREBASE_DISABLE_APP_VERIFICATION=1

# Backend SMS (only if EXPO_PUBLIC_OTP_MODE=backend):
# EXPO_PUBLIC_OTP_MODE=backend
# EXPO_PUBLIC_FIREBASE_PHONE=0
