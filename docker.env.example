# Copy to project root `.env` for Docker Compose (`docker compose` loads it automatically).
# NEVER commit `.env`.

# Strong secret for JWT signing (required)
JWT_SECRET=replace-with-openssl-rand-hex-32

POSTGRES_PASSWORD=postgres

# API on host (use 127.0.0.1:4000 when Caddy or another proxy is the public edge)
API_PUBLISH_PORT=127.0.0.1:4000

# nginx admin container (use 127.0.0.1:8080 when Caddy terminates TLS on the host)
WEB_PORT=127.0.0.1:8080

JWT_EXPIRES_IN=7d

DEV_OTP=123456
EXPOSE_DEV_OTP=0

# Real SMS (pick one provider)
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=your_fast2sms_api_key
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Comma-separated browser origins when admin or web clients are NOT same-origin as API
# CORS_ORIGIN=https://your-admin.example.com,https://your-app.example.com
